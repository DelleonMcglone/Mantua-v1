# Privy (D-005, D-006 ACCEPTED)
VITE_PRIVY_APP_ID=

# WalletConnect (D-007 ACCEPTED)
VITE_WALLETCONNECT_PROJECT_ID=

# Backend base URL. Leave EMPTY in dev so API calls go through the Vite
# proxy (/api -> http://localhost:3001), same-origin. Setting an explicit
# cross-origin URL here triggers CORS preflight failures ("failed to
# fetch") because the dev server has no CORS middleware. Set this only in
# production, to the deployed API host.
VITE_API_BASE_URL=

# Network gate. Default "mainnet" = Base Mainnet (chain 8453). The app
# runs on Base only; this flips the Privy default chain + token registry.
# Server-side has the matching MANTUA_NETWORK env var.
VITE_MANTUA_NETWORK=mainnet

# Optional: override the Base RPC (defaults to
# https://mainnet.base.org). Use a private RPC (Alchemy, QuickNode)
# for production-like load testing.
VITE_BASE_RPC_URL=

# Optional: Mantua hook addresses on Base Mainnet (deployment pending —
# see docs/tasks/v2-roadmap.md). Leave empty until the hooks deploy;
# hook venues degrade gracefully to the no-hook path when unset.
VITE_STABLE_PROTECTION_HOOK_ADDRESS=
VITE_DYNAMIC_FEE_HOOK_ADDRESS=
