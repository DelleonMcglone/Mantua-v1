{
  "name": "Mantua — sports prediction markets",
  "short_name": "Mantua",
  "description": "Find a game, ask your agent, take a position in three taps, and watch it live.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "lang": "en",
  "categories": ["sports", "finance"],
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Markets",
      "short_name": "Markets",
      "description": "What can I trade right now?",
      "url": "/?source=pwa&open=discover",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My positions",
      "short_name": "Positions",
      "url": "/?source=pwa&open=profile",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Agent",
      "short_name": "Agent",
      "url": "/?source=pwa&open=agent",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
