NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://user:password@localhost:5432/mantua

PRIVY_APP_ID=
PRIVY_APP_SECRET=

UNISWAP_TRADING_API_KEY=

# The Graph decentralized network API key (https://thegraph.com/studio/apikeys/)
# Optional: when present, /api/positions will include pre-Mantua v4 positions
# discovered via the Uniswap v4 Base subgraph.
THE_GRAPH_API_KEY=
UNISWAP_V4_BASE_SUBGRAPH_ID=HNCFA9TyBqpo5qpe6QreQABAA1kV8g46mhkCcicu6v2R

# ── Circle ────────────────────────────────────────────────────────────
# Agent wallets (Developer-Controlled Wallets), USDC flows, and gas
# sponsorship. Provision by hand in the Circle Developer Console —
# runbook: docs/tasks/018-circle-credentials.md. Verify with
# `npm run circle:preflight -w @mantua/server`.
#
# NEVER commit real values. This file ships blanks only.

# Console API key, format PREFIX:ID:SECRET. Use a LIVE_API_KEY for Base
# Mainnet — a TEST key silently puts the agent on testnet.
CIRCLE_API_KEY=

# Your registered 32-byte entity secret (64 hex chars). This is FULL
# CUSTODY of every agent wallet: treat it like a private key, keep it in a
# secrets manager, and store the recovery file offline (never in the repo).
# Generate + register: https://developers.circle.com/wallets/dev-controlled/register-entity-secret
CIRCLE_ENTITY_SECRET=

# The wallet set agent wallets are provisioned into. PIN THIS before
# deploying: unset, every serverless cold start creates a new wallet set,
# scattering wallets outside the Gas Station policy. Production refuses to
# boot without it once the two vars above are set.
CIRCLE_WALLET_SET_ID=

# Gas Station (paymaster) policy id, from Console → Gas Station. Circle
# sponsors SCA transactions automatically from the policy that is ACTIVE and
# the default for Base (transactions use only the network's default policy).
# Recorded as a UUID and consumed two ways: production refuses to create an
# unsponsored transaction, and every transaction carries the id as Circle's
# refId so the console's per-policy sponsored-transactions table proves the
# recorded policy is the one actually sponsoring the code. Without it, an
# agent wallet with no ETH fails as an opaque timeout.
CIRCLE_GAS_STATION_POLICY_ID=

# Local-testing only: point the Circle SDK at a stub server (preflight
# evidence, fixtures). NEVER set this outside local dev — it redirects all
# Circle traffic.
CIRCLE_API_BASE_URL=

# Optional: webhook signing key id for Circle transaction notifications
# (Console → Webhooks). Circle recommends webhooks over polling for terminal
# transaction state.
CIRCLE_WEBHOOK_KEY_ID=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Network gate. Default "mainnet" — the whole app (swaps, pools, liquidity,
# agent) runs on Base Mainnet (chain 8453).
MANTUA_NETWORK=mainnet

# Base Mainnet RPC — all server-side viem reads/writes. Point at a private
# endpoint (Alchemy/QuickNode) in production for rate-limit headroom.
BASE_RPC_URL=https://mainnet.base.org

# Mantua hook addresses on Base Mainnet — deployment pending (see
# docs/tasks/v2-roadmap.md, P9-013). Leave unset until the hooks are
# deployed and verified; hook features degrade gracefully while null.
# STABLE_PROTECTION_HOOK_ADDRESS=
# DYNAMIC_FEE_HOOK_ADDRESS=
# AGENTIC_COMMERCE_ADDRESS=

MANTUA_KILL_SWITCH=0
MANTUA_FEE_BPS=10
MANTUA_FEE_RECIPIENT=
MANTUA_FEE_ADMIN_KEY=
