# Base Mainnet agent — environment. Copy to agent/.env and fill secrets.
# Token addresses are the canonical Base Mainnet deployments (Circle docs
# for USDC/EURC, Coinbase for cbBTC); sources are recorded in
# docs/architecture.md.

# Base Mainnet RPC (reads + tx submission). Default is the public endpoint;
# override with a private endpoint for production headroom.
# Fallback: https://base-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org

# Agent signing key (0x + 64 hex). Gas is paid in ETH on Base — fund the
# agent address with real ETH + USDC (see docs/funding-runbook.md).
# NEVER commit a real key; agent/.env is gitignored.
AGENT_PRIVATE_KEY=

# ERC-8004 registries (IdentityRegistry / ReputationRegistry /
# ValidationRegistry). Base Mainnet deployment pending — see
# docs/tasks/v2-roadmap.md. Leave unset to disable the identity/reputation
# actions; set all three (or none) once the contracts are deployed.
#IDENTITY_REGISTRY_ADDRESS=
#REPUTATION_REGISTRY_ADDRESS=
#VALIDATION_REGISTRY_ADDRESS=

# ERC-8183 AgenticCommerce (job + USDC escrow). Base Mainnet deployment
# pending — see docs/tasks/v2-roadmap.md. Leave unset to disable the job
# actions.
#AGENTIC_COMMERCE_ADDRESS=

# Allowlisted assets (the ONLY three the agent may operate on), Base
# Mainnet ERC-20 addresses. Defaults are baked into src/config/env.ts;
# override only if you know what you are doing.
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
EURC_ADDRESS=0x60a3E35Cc302bFA44Cb288Bc5a4F316Fdb1adb42
CBBTC_ADDRESS=0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf

# Warn when the agent's ETH gas balance drops below this many ETH.
LOW_GAS_WARN_ETH=0.001
